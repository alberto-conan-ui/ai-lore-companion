{
  "name": "@ai-lore-companion/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure-Node logic for the AI-Lore cockpit: tracker chain reader, change queue, persistence, watcher.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test --enable-source-maps \"dist-test/test/**/*.test.js\"",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
