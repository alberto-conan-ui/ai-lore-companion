{
  "name": "@ai-lore-companion/app",
  "productName": "AI-Lore",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop shell for the AI-Lore cockpit.",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "electron-rebuild -f -o node-pty",
    "dev": "electron-vite dev",
    "prebuild": "electron-rebuild -f -o node-pty",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vite-node scripts/typecheck.ts --",
    "typecheck:node": "tsc -b tsconfig.node.json",
    "clean": "rm -rf out",
    "test": "npm run test:headless; h=$?; npm run test:component; c=$?; [ $h -eq 0 ] && [ $c -eq 0 ]",
    "test:headless": "OUT=\"${AI_LORE_APP_TEST_OUT:-dist-test}\" && rm -rf \"$OUT\" && tsc -p tsconfig.test.json --outDir \"$OUT\" && echo '{\"type\":\"module\"}' > \"$OUT/package.json\" && node --import ./test/headless/register-electron.mjs --test --enable-source-maps \"$OUT/test/headless/**/*.test.js\"",
    "test:component": "vitest run",
    "bench:search": "OUT=\"${AI_LORE_APP_TEST_OUT:-dist-test}\" && rm -rf \"$OUT\" && tsc -p tsconfig.test.json --outDir \"$OUT\" && echo '{\"type\":\"module\"}' > \"$OUT/package.json\" && node --import ./test/headless/register-electron.mjs --enable-source-maps \"$OUT/test/bench/search.bench.js\"",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && PYTHON=/usr/bin/python3 npm_config_python=/usr/bin/python3 electron-builder",
    "dist:space": "npm run build && PYTHON=/usr/bin/python3 npm_config_python=/usr/bin/python3 electron-builder --config electron-builder.space.json",
    "postinstall": "electron-rebuild -f -o node-pty"
  },
  "dependencies": {
    "@ai-lore-companion/core": "*",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-popover": "^1.1.18",
    "@vscode/ripgrep": "^1.15.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dockview": "^4.13.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.49.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "author": "AI-Lore",
  "build": {
    "appId": "com.ai-lore.cockpit",
    "productName": "AI-Lore",
    "copyright": "Copyright \u00a9 2026 AI-Lore",
    "electronVersion": "32.2.7",
    "directories": {
      "output": "dist"
    },
    "extraMetadata": {
      "dependencies": {
        "chokidar": "^3.6.0",
        "node-pty": "^1.1.0"
      }
    },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      {
        "from": "../spec/lore-1.0",
        "to": "lore-1.0",
        "filter": ["**/*"]
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "ai-lore",
      "category": "Development",
      "maintainer": "AI-Lore",
      "synopsis": "Human Lead cockpit for AI-Lore projects",
      "description": "Desktop cockpit for AI-Lore projects: focus chain, Memory and Payload navigation, git drift and save-point diffs, integrated terminals and editor."
    }
  }
}
