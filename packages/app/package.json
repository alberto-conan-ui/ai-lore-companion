{
  "name": "@ai-lore-companion/app",
  "productName": "AI-Lore",
  "version": "0.9.1",
  "private": true,
  "description": "Electron desktop shell for the AI-Lore cockpit.",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "electron-rebuild -f -o better-sqlite3,node-pty",
    "dev": "electron-vite dev",
    "prebuild": "electron-rebuild -f -o better-sqlite3,node-pty",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf out",
    "test": "npm run test:headless",
    "test:headless": "rm -rf dist-test && tsc -p tsconfig.test.json && echo '{\"type\":\"module\"}' > dist-test/package.json && node --test --enable-source-maps \"dist-test/test/headless/**/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && PYTHON=/usr/bin/python3 npm_config_python=/usr/bin/python3 electron-builder",
    "postinstall": "electron-rebuild -f -o better-sqlite3,node-pty"
  },
  "dependencies": {
    "@ai-lore-companion/core": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ag-grid-enterprise": "^35.3.0",
    "ag-grid-react": "^35.3.0",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^3.6.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright": "^1.49.0",
    "vite": "^5.4.11"
  },
  "author": "AI-Lore",
  "build": {
    "appId": "com.ai-lore.cockpit",
    "productName": "AI-Lore",
    "copyright": "Copyright © 2026 AI-Lore",
    "electronVersion": "32.2.7",
    "directories": {
      "output": "dist"
    },
    "extraMetadata": {
      "dependencies": {
        "better-sqlite3": "^11.5.0",
        "chokidar": "^3.6.0",
        "node-pty": "^1.1.0"
      }
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
