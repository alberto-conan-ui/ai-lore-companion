{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2022"],
    "outDir": "./dist-test",
    "rootDir": ".",
    "noEmit": false,
    "composite": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "test/headless/**/*.ts"]
}
