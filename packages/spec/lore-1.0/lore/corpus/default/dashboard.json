      "source": "pm",
      "title": "Blockers",
      "limit": 8,
      "instruction": "List evidenced blockers, what can unblock each, and unresolved unknowns. Return an empty list when none are known."
    },
    {
      "id": "decisions",
      "type": "list",
      "source": "pm",
      "title": "Decisions needed",
      "limit": 8,
