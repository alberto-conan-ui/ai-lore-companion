      "id": "position",
      "type": "text",
      "source": "pm",
      "title": "Current position",
      "instruction": "Summarise the present goal and evidence of progress. Include relevant Workbench work, distinguish observed facts from proposals, and state missing sources."
    },
    {
      "id": "plan",
      "type": "plan",
      "source": "companion",
      "title": "Where everything stands"
    },
